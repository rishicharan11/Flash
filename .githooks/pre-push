#!/bin/sh
# Local checkpoint. Human approval must be verified before recording a commit.
set -eu

deny() {
    printf '%s\n' "Push blocked: $*" >&2
    exit 1
}

case "${2-}" in
    https://github.com/rishicharan11/Flash|\
    https://github.com/rishicharan11/Flash.git|\
    git@github.com:rishicharan11/Flash.git|\
    ssh://git@github.com/rishicharan11/Flash.git) ;;
    *) deny "destination is not rishicharan11/Flash." ;;
esac

approval_file=$(git rev-parse --git-path paper-approval)
[ -f "$approval_file" ] || deny "review in Paper and obtain user approval first."
{
    IFS=' ' read -r approved_oid approved_ref extra ||
        deny "invalid approval record."
    if IFS= read -r trailing || [ -n "$trailing" ]; then
        deny "approval record must contain exactly one line."
    fi
} < "$approval_file"
[ -z "$extra" ] || deny "invalid approval record."
case "$approved_ref" in
    refs/heads/?*) ;;
    *) deny "approval must name a branch destination." ;;
esac
case "$approved_oid" in
    ''|*[!0-9a-f]*) deny "invalid approved commit ID." ;;
esac
kind=$(git cat-file -t "$approved_oid" 2>/dev/null) ||
    deny "approved commit does not exist locally."
[ "$kind" = commit ] || deny "approval must name a commit."

count=0
while read -r local_ref local_oid remote_ref remote_oid; do
    count=$((count + 1))
    [ "$count" -eq 1 ] || deny "approve and publish one ref at a time."
    [ "$local_ref" != '(delete)' ] || deny "deletion is outside this workflow."
    [ "$local_oid" = "$approved_oid" ] ||
        deny "this commit has no matching approval; review the changed batch."
    [ "$remote_ref" = "$approved_ref" ] ||
        deny "destination ref differs from the approved ref."
done
[ "$count" -eq 1 ] || deny "no approved ref update was supplied."
